NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API Key (For Content Writing, Imagen 3 Images, and AI Assistant Chat)
GEMINI_API_KEY=your_gemini_api_key

# Replicate API Token (For AI Video Generation)
REPLICATE_API_TOKEN=your_replicate_api_token


# ==============================================================================
# 2. AGENCY MASTER AD APIS (GLOBALLY SPONSORED CUSTOMER FEED ADS)
# ==============================================================================
# Yaha agency apna Master Ad Account credentials daalegi.
# Jab bhi koi user GorillaGo se ad create karke "Launch to Feeds" karega,
# to ad inhi credentials ke through target customers ke feeds/reels me
# "Sponsored" ad bankar dispatch hogi. Users se kabhi koi ad key nahi maangi jayegi!

# --- META (FACEBOOK & INSTAGRAM SPONSORED FEED ADS) ---
# Meta Business Suite -> System Users -> Generate Token (ads_management, ads_read, business_management)
AGENCY_META_ACCESS_TOKEN=
# Meta Business Manager Ad Account ID (e.g. act_123456789012345)
AGENCY_META_AD_ACCOUNT_ID=

# --- GOOGLE ADS (SEARCH, DISPLAY & YOUTUBE SPONSORED ADS) ---
# Google Ads Developer Token (From Google Ads Manager Center)
AGENCY_GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads Customer/Manager ID without hyphens (e.g. 1234567890)
AGENCY_GOOGLE_ADS_CUSTOMER_ID=

# --- LINKEDIN ADS (SPONSORED B2B FEED ADS) ---
# LinkedIn Marketing Developer Access Token
AGENCY_LINKEDIN_ACCESS_TOKEN=
# LinkedIn Sponsored Ad Account ID (e.g. 501234567)
AGENCY_LINKEDIN_AD_ACCOUNT_ID=

# --- X / TWITTER ADS (PROMOTED TWEETS & ADS) ---
# X Developer Portal Ads Bearer Token
AGENCY_X_ADS_BEARER_TOKEN=


# ==============================================================================
# 3. 1-CLICK SOCIAL LOGIN OAUTH (USERS KE SOCIAL PROFILE CONNECT KE LIYE)
# ==============================================================================
# Ye credentials agency ke developer app ke hote hain jisse user ko
# standard "Continue with Facebook / LinkedIn" ka 1-click button milta hai.
# Isse user ka apna personal profile/page organic posts ke liye connect hota hai.

# Meta App (Facebook & Instagram 1-Click Connect)
# developers.facebook.com -> Your App -> App Settings -> Basic
META_CLIENT_ID=
META_CLIENT_SECRET=

# LinkedIn App (LinkedIn Profile & Pages 1-Click Connect)
# linkedin.com/developers -> Your App -> Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X / Twitter App (X 1-Click Connect)
# developer.x.com -> User Authentication Settings (OAuth 2.0)
X_CLIENT_ID=
X_CLIENT_SECRET=


# ==============================================================================
# 4. PAYMENT GATEWAYS (SUBSCRIPTION PLANS & AI CREDIT PACKS)
# ==============================================================================
# Agar ye keys blank rahengi, to website automatically "Sandbox Simulator" mode
# me chalegi jisse aap bina payment ke testing kar sakte hain.

# --- STRIPE (GLOBAL / INTERNATIONAL USERS & SUBSCRIPTIONS) ---
# Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe Price IDs for recurring subscription plans
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_ENTERPRISE=

# --- RAZORPAY (INDIA / UPI, RUPAY, NETBANKING & WALLETS) ---
# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# ==============================================================================
# 5. APP BASE URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
